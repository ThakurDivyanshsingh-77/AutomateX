<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"/>
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'Helvetica Neue', Helvetica, Arial, sans-serif; color: #1e293b; background: #fff; }
  .page { padding: 60px; }
  .header { border-bottom: 3px solid {{brandColor}}; padding-bottom: 24px; margin-bottom: 32px; }
  .company-name { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: {{brandColor}}; }
  .letter-date { font-size: 12px; color: #64748b; margin-top: 8px; }
  .address-block { font-size: 12px; line-height: 1.8; color: #334155; margin-bottom: 24px; }
  .subject { font-size: 14px; font-weight: 800; text-decoration: underline; margin-bottom: 20px; color: #1e293b; }
  .body-text { font-size: 13px; line-height: 2; color: #334155; white-space: pre-line; margin-bottom: 24px; }
  .details-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 10px; padding: 20px; margin: 24px 0; }
  .detail-row { display: flex; justify-content: space-between; padding: 6px 0; border-bottom: 1px solid #e2e8f0; font-size: 12px; }
  .detail-row:last-child { border-bottom: none; }
  .detail-label { color: #64748b; font-weight: 600; }
  .detail-value { color: #1e293b; font-weight: 700; }
  .closing { font-size: 13px; color: #334155; margin-top: 28px; }
  .signature-block { margin-top: 40px; }
  .signature-line { border-top: 1.5px solid #334155; width: 180px; margin-bottom: 6px; }
  .sig-name { font-size: 13px; font-weight: 800; color: #1e293b; }
  .sig-title { font-size: 11px; color: #64748b; }
  .footer { margin-top: 48px; padding-top: 16px; border-top: 1px solid #e2e8f0; font-size: 10px; color: #94a3b8; text-align: center; }
</style>
</head>
<body>
  <div class="page">
    <div class="header">
      {{#if logoUrl}}<img src="{{logoUrl}}" style="height:50px;margin-bottom:12px;" /><br/>{{/if}}
      <div class="company-name">{{companyName}}</div>
      <div class="letter-date">{{letterDate}}</div>
    </div>
    <div class="address-block">
      <strong>{{candidateName}}</strong><br/>
      {{candidateAddress}}<br/>
      {{candidateEmail}}
    </div>
    <div class="subject">Subject: {{subject}}</div>
    <div class="body-text">{{openingParagraph}}</div>
    <div class="details-box">
      <div class="detail-row"><span class="detail-label">Position</span><span class="detail-value">{{position}}</span></div>
      <div class="detail-row"><span class="detail-label">Department</span><span class="detail-value">{{department}}</span></div>
      <div class="detail-row"><span class="detail-label">Start Date</span><span class="detail-value">{{startDate}}</span></div>
      <div class="detail-row"><span class="detail-label">CTC / Salary</span><span class="detail-value">{{salary}}</span></div>
      <div class="detail-row"><span class="detail-label">Reporting To</span><span class="detail-value">{{reportingTo}}</span></div>
      <div class="detail-row"><span class="detail-label">Work Location</span><span class="detail-value">{{workLocation}}</span></div>
    </div>
    <div class="body-text">{{closingParagraph}}</div>
    <div class="signature-block">
      {{#if signatureImg}}<img src="{{signatureImg}}" style="height:40px;margin-bottom:4px;" /><br/>{{/if}}
      <div class="signature-line"></div>
      <div class="sig-name">{{signatoryName}}</div>
      <div class="sig-title">{{signatoryTitle}}</div>
    </div>
    <div class="footer">{{companyName}} • {{companyAddress}} • {{companyEmail}} • {{companyWebsite}}</div>
  </div>
</body>
</html>
